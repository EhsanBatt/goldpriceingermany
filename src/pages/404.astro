---
import BaseLayout from '~theme/components/BaseLayout.astro';
import { defaultLocale } from '~theme/i18n/utils';
---

<BaseLayout locale={defaultLocale} title="404 - Page Not Found">
  <div class="container py-24 text-center max-w-lg mx-auto">
    <div class="text-7xl mb-6 animate-bounce">👑</div>
    <h1 class="text-5xl font-black text-white mb-4">404</h1>
    <h2 class="text-2xl font-bold text-[#d4af37] mb-6">الصفحة غير موجودة / Page Not Found</h2>
    <p class="text-slate-400 mb-8">عذراً، الصفحة التي تبحث عنها غير متاحة أو تم نقلها إلى رابط آخر.</p>
    <a href="/" class="btn-primary inline-flex items-center gap-2">🏠 العودة إلى الصفحة الرئيسية</a>
  </div>
</BaseLayout>
