---
import { getTranslations } from '~theme/i18n';
import { getLocalizedUrl, supportedLocales, defaultLocale } from '~theme/i18n/utils';
import siteConfig from '@/config/site.json';

const { locale = defaultLocale } = Astro.props;
const t = getTranslations(locale);
const year = new Date().getFullYear();
const currentPath = Astro.url.pathname;
const social = siteConfig.socialLinks || {};
const hasSocial = Object.values(social).some(url => Boolean(url));
---

<footer class="bg-[#05080e] border-t border-[rgba(212,175,55,0.22)] py-12 text-slate-400 text-sm mt-20">
  <div class="container grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-10">
    <div class="flex flex-col gap-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl flex items-center justify-center text-xl shadow-lg" style="background: var(--gold-gradient);">👑</div>
        <span class="text-lg font-bold text-white">{t.site.title.split(' ')[0]} {t.site.title.split(' ')[1]} {t.site.title.split(' ')[2]}</span>
      </div>
      <p class="leading-relaxed text-slate-400">{t.site.footerDesc}</p>

      {hasSocial && (
        <div class="flex items-center gap-3 mt-2">
          {social.facebook && <a href={social.facebook} target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-lg bg-[#161e31] border border-[rgba(212,175,55,0.2)] flex items-center justify-center text-white hover:border-[#d4af37] transition-all" title="Facebook">FB</a>}
          {social.twitter && <a href={social.twitter} target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-lg bg-[#161e31] border border-[rgba(212,175,55,0.2)] flex items-center justify-center text-white hover:border-[#d4af37] transition-all" title="Twitter">X</a>}
          {social.linkedin && <a href={social.linkedin} target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-lg bg-[#161e31] border border-[rgba(212,175,55,0.2)] flex items-center justify-center text-white hover:border-[#d4af37] transition-all" title="LinkedIn">IN</a>}
          {social.pinterest && <a href={social.pinterest} target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-lg bg-[#161e31] border border-[rgba(212,175,55,0.2)] flex items-center justify-center text-white hover:border-[#d4af37] transition-all" title="Pinterest">PIN</a>}
        </div>
      )}
    </div>

    <div>
      <h4 class="text-white font-bold text-base mb-4">{t.nav.home}</h4>
      <ul class="flex flex-col gap-2 list-none p-0">
        <li><a href={getLocalizedUrl('/#live-prices', locale)} class="hover:text-[#d4af37] transition-colors">{t.nav.livePrices}</a></li>
        <li><a href={getLocalizedUrl('/#chart', locale)} class="hover:text-[#d4af37] transition-colors">{t.nav.chart}</a></li>
        <li><a href={getLocalizedUrl('/#calculator', locale)} class="hover:text-[#d4af37] transition-colors">{t.nav.calculator}</a></li>
        <li><a href={getLocalizedUrl('/#alloys', locale)} class="hover:text-[#d4af37] transition-colors">{t.nav.alloys}</a></li>
      </ul>
    </div>

    <div>
      <h4 class="text-white font-bold text-base mb-4">{t.nav.about} & Legal</h4>
      <ul class="flex flex-col gap-2 list-none p-0">
        <li><a href={getLocalizedUrl('/about-us', locale)} class="hover:text-[#d4af37] transition-colors">{t.nav.about}</a></li>
        <li><a href={getLocalizedUrl('/contact-us', locale)} class="hover:text-[#d4af37] transition-colors">{t.nav.contact}</a></li>
        <li><a href={getLocalizedUrl('/terms', locale)} class="hover:text-[#d4af37] transition-colors">{t.nav.terms}</a></li>
        <li><a href={getLocalizedUrl('/privacy', locale)} class="hover:text-[#d4af37] transition-colors">{t.nav.privacy}</a></li>
        <li><a href={getLocalizedUrl('/sitemap', locale)} class="hover:text-[#d4af37] transition-colors">Sitemap</a></li>
      </ul>
    </div>

    <div>
      <h4 class="text-white font-bold text-base mb-4">{t.common.language}</h4>
      <div class="flex flex-wrap gap-2">
        {supportedLocales.map((loc) => (
          <a
            href={getLocalizedUrl(currentPath, loc)}
            class={`px-3 py-1.5 rounded-lg border text-xs font-bold transition-all ${loc === locale ? 'bg-[rgba(212,175,55,0.2)] border-[#d4af37] text-[#d4af37]' : 'bg-[#161e31] border-slate-700 text-slate-300 hover:border-slate-500'}`}
          >
            {loc.toUpperCase()}
          </a>
        ))}
      </div>
      <p class="mt-4 text-xs text-slate-500 leading-relaxed">
        الأسعار المعروضة هي استرشادية تعكس حركة السوق العالمي وقد تختلف قليلاً حسب محلات الصاغة والبنوك في ولايات ألمانيا.
      </p>
    </div>
  </div>

  <div class="container border-t border-[rgba(255,255,255,0.05)] pt-6 text-center text-xs text-slate-500">
    <p>{t.common.copyright.replace('{year}', year.toString())}</p>
  </div>
</footer>
