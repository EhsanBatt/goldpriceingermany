---
import '@/styles/global.css';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { getTranslations } from '~theme/i18n';
import { getDir, defaultLocale, getLocalizedUrl } from '~theme/i18n/utils';
import siteConfig from '@/config/site.json';

const {
  title,
  description,
  locale = defaultLocale,
  ogImage = `${siteConfig.baseUrl}/og-image.jpg`,
  ogType = 'website',
  schema = null
} = Astro.props;

const t = getTranslations(locale);
const dir = getDir(locale);
const pageTitle = title || t.site.title;
const pageDesc = description || t.site.description;
const canonicalUrl = new URL(Astro.url.pathname, siteConfig.baseUrl).toString();
const localeMap: Record<string, string> = { ar: 'ar_AR', en: 'en_US', de: 'de_DE', tr: 'tr_TR' };
const ogLocale = localeMap[locale] || 'ar_AR';

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Gold Price Germany",
  "url": siteConfig.baseUrl,
  "legalName": "Gold Price in Germany Portal",
  "logo": `${siteConfig.baseUrl}/logo.png`,
  "description": t.site.description,
  "sameAs": Object.values(siteConfig.socialLinks).filter(Boolean)
};

const navSchema = {
  "@context": "https://schema.org",
  "@type": "SiteNavigationElement",
  "name": [t.nav.home, t.nav.livePrices, t.nav.chart, t.nav.calculator, t.nav.alloys, t.nav.blog],
  "url": [
    `${siteConfig.baseUrl}${getLocalizedUrl('/', locale)}`,
    `${siteConfig.baseUrl}${getLocalizedUrl('/#live-prices', locale)}`,
    `${siteConfig.baseUrl}${getLocalizedUrl('/#chart', locale)}`,
    `${siteConfig.baseUrl}${getLocalizedUrl('/#calculator', locale)}`,
    `${siteConfig.baseUrl}${getLocalizedUrl('/#alloys', locale)}`,
    `${siteConfig.baseUrl}${getLocalizedUrl('/blog', locale)}`
  ]
};
---

<!DOCTYPE html>
<html lang={locale} dir={dir}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  
  <meta name="robots" content="index, follow, max-snippet:-1, max-video-preview:-1, max-image-preview:large" />
  <meta name="googlebot" content="index, follow" />

  {siteConfig.webmasterVerification.google && <meta name="google-site-verification" content={siteConfig.webmasterVerification.google} />}
  {siteConfig.webmasterVerification.bing && <meta name="msvalidate.01" content={siteConfig.webmasterVerification.bing} />}
  {siteConfig.webmasterVerification.yandex && <meta name="yandex-verification" content={siteConfig.webmasterVerification.yandex} />}

  <!-- Open Graph -->
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDesc} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content="Gold Price Germany" />
  <meta property="og:locale" content={ogLocale} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={pageTitle} />
  <meta property="og:type" content={ogType} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDesc} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Organization Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  <!-- Nav Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(navSchema)} />
  <!-- Additional Page Schema -->
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
</head>
<body class="min-h-screen flex flex-col bg-white text-slate-900">
  <Header locale={locale} />
  <main class="flex-grow w-full">
    <slot />
  </main>
  <Footer locale={locale} />
</body>
</html>
