---
import { getTranslations } from '~theme/i18n';
import { getLocalizedUrl, supportedLocales, defaultLocale } from '~theme/i18n/utils';

const { locale = defaultLocale } = Astro.props;
const t = getTranslations(locale);
const currentPath = Astro.url.pathname;

const localeNames: Record<string, string> = { ar: 'العربية', en: 'English', de: 'Deutsch', tr: 'Türkçe' };
const tagline = locale === 'ar' ? 'البوابة الرسمية لأسعار الذهب باليورو' : 'Official Portal for Gold in EUR';
---

<header class="navbar sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200 py-5">
  <div class="container flex justify-between items-center">
    <a href={getLocalizedUrl('/', locale)} class="flex items-center gap-3.5 no-underline">
      <svg class="w-10 h-10 shrink-0" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <circle cx="20" cy="20" r="19" stroke="#b45309" stroke-width="2"/>
        <path d="M12 24L17 14L20 20L23 14L28 24" stroke="#b45309" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <div class="flex flex-col">
        <span class="text-base font-extrabold tracking-tight text-slate-900 leading-tight">{t.site.title.split('|')[0].trim()}</span>
        <small class="text-xs text-amber-700 font-semibold leading-tight">{tagline}</small>
      </div>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden lg:flex items-center gap-8">
      <ul class="flex items-center gap-8 list-none m-0 p-0">
        <li><a href={getLocalizedUrl('/', locale)} class="text-slate-700 font-semibold hover:text-amber-700 transition-colors">{t.nav.home}</a></li>
        <li><a href={getLocalizedUrl('/#chart', locale)} class="text-slate-700 font-semibold hover:text-amber-700 transition-colors">{t.nav.chart}</a></li>
        <li><a href={getLocalizedUrl('/#calculator', locale)} class="text-slate-700 font-semibold hover:text-amber-700 transition-colors">{t.nav.calculator}</a></li>
        <li><a href={getLocalizedUrl('/#alloys', locale)} class="text-slate-700 font-semibold hover:text-amber-700 transition-colors">{t.nav.alloys}</a></li>
        <li><a href={getLocalizedUrl('/blog', locale)} class="text-slate-700 font-semibold hover:text-amber-700 transition-colors">{t.nav.blog}</a></li>
        <li><a href={getLocalizedUrl('/about-us', locale)} class="text-slate-700 font-semibold hover:text-amber-700 transition-colors">{t.nav.about}</a></li>
        <li><a href={getLocalizedUrl('/contact-us', locale)} class="text-slate-700 font-semibold hover:text-amber-700 transition-colors">{t.nav.contact}</a></li>
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <!-- Language Switcher -->
      <div class="relative group">
        <button class="flex items-center gap-1.5 bg-white border border-slate-200 px-3 py-1.5 rounded-lg text-sm font-bold text-slate-700 hover:border-amber-400 transition-all" aria-label={t.common.language}>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 010 18M12 3a15 15 0 000 18"/></svg>
          {locale.toUpperCase()}
        </button>
        <div class="absolute top-full mt-2 end-0 bg-white border border-slate-200 rounded-xl py-2 w-36 shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all flex flex-col z-50">
          {supportedLocales.map((loc) => (
            <a
              href={getLocalizedUrl(currentPath, loc)}
              class={`px-4 py-1.5 text-sm font-semibold hover:bg-amber-50 ${loc === locale ? 'text-amber-700' : 'text-slate-600'}`}
            >
              {localeNames[loc] || loc.toUpperCase()}
            </a>
          ))}
        </div>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden bg-white border border-slate-200 text-slate-700 p-2 rounded-xl flex items-center justify-center"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Toggle Menu"
      >
        <svg id="mobile-menu-icon" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Panel -->
  <div id="mobile-nav" class="fixed inset-0 bg-white z-50 flex flex-col justify-center items-center gap-6 opacity-0 pointer-events-none transition-all duration-300" aria-hidden="true">
    <button id="mobile-close-btn" class="absolute top-6 end-6 text-slate-500 p-2" aria-label="Close Menu">
      <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
    <ul class="flex flex-col items-center gap-6 list-none text-xl font-bold">
      <li><a href={getLocalizedUrl('/', locale)} class="mobile-link text-slate-900 hover:text-amber-700">{t.nav.home}</a></li>
      <li><a href={getLocalizedUrl('/#chart', locale)} class="mobile-link text-slate-900 hover:text-amber-700">{t.nav.chart}</a></li>
      <li><a href={getLocalizedUrl('/#calculator', locale)} class="mobile-link text-slate-900 hover:text-amber-700">{t.nav.calculator}</a></li>
      <li><a href={getLocalizedUrl('/#alloys', locale)} class="mobile-link text-slate-900 hover:text-amber-700">{t.nav.alloys}</a></li>
      <li><a href={getLocalizedUrl('/blog', locale)} class="mobile-link text-slate-900 hover:text-amber-700">{t.nav.blog}</a></li>
      <li><a href={getLocalizedUrl('/about-us', locale)} class="mobile-link text-slate-900 hover:text-amber-700">{t.nav.about}</a></li>
      <li><a href={getLocalizedUrl('/contact-us', locale)} class="mobile-link text-slate-900 hover:text-amber-700">{t.nav.contact}</a></li>
    </ul>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const menuIcon = document.getElementById('mobile-menu-icon');
  const closeBtn = document.getElementById('mobile-close-btn');
  const mobileNav = document.getElementById('mobile-nav');
  const mobileLinks = document.querySelectorAll('.mobile-link');

  const HAMBURGER = '<path d="M4 6h16M4 12h16M4 18h16"/>';
  const CLOSE = '<path d="M6 6l12 12M18 6L6 18"/>';

  function openMenu() {
    if (mobileNav && menuBtn) {
      mobileNav.classList.remove('opacity-0', 'pointer-events-none');
      mobileNav.setAttribute('aria-hidden', 'false');
      menuBtn.setAttribute('aria-expanded', 'true');
      if (menuIcon) menuIcon.innerHTML = CLOSE;
      document.body.style.overflow = 'hidden';
    }
  }

  function closeMenu() {
    if (mobileNav && menuBtn) {
      mobileNav.classList.add('opacity-0', 'pointer-events-none');
      mobileNav.setAttribute('aria-hidden', 'true');
      menuBtn.setAttribute('aria-expanded', 'false');
      if (menuIcon) menuIcon.innerHTML = HAMBURGER;
      document.body.style.overflow = '';
    }
  }

  menuBtn?.addEventListener('click', () => {
    const isOpen = menuBtn.getAttribute('aria-expanded') === 'true';
    if (isOpen) closeMenu(); else openMenu();
  });

  closeBtn?.addEventListener('click', closeMenu);
  mobileLinks.forEach(link => link.addEventListener('click', closeMenu));
</script>
