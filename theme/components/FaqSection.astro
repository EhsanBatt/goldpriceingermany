---
import { getTranslations } from '~theme/i18n';
import { defaultLocale } from '~theme/i18n/utils';

const { locale = defaultLocale } = Astro.props;
const t = getTranslations(locale);
const faqs = (t.faq || []).filter((item: any) => item.display !== false);
const isAr = locale === 'ar';
const isDe = locale === 'de';
const isTr = locale === 'tr';

const sectionTitle = isAr ? 'أسئلة شائعة وإجابات واضحة' : isDe ? 'Häufig gestellte Fragen (FAQ)' : isTr ? 'Sıkça Sorulan Sorular' : 'Frequently Asked Questions';
const sectionDesc = isAr ? 'كل ما يهمك معرفته حول قوانين شراء وبيع الذهب، الضرائب، والفرق بين الأعيرة في ألمانيا' : isDe ? 'Alles, was Sie über Goldgesetze, Steuern und Karatbewertungen in Deutschland wissen müssen.' : isTr ? 'Almanya\'da altın alım-satım yasaları, vergiler ve ayar farkları hakkında bilmeniz gereken her şey.' : 'Everything you need to know about German bullion laws, taxation, and karat valuation.';
---

<section class="py-16 md:py-24 bg-slate-50 border-t border-slate-200" id="faq">
  <div class="container max-w-4xl">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-4">{sectionTitle}</h2>
      <p class="text-slate-600 text-lg">{sectionDesc}</p>
    </div>

    <div class="flex flex-col gap-5">
      {faqs.map((faq: any, idx: number) => (
        <details class="card bg-white overflow-hidden group" open={idx === 0}>
          <summary class="p-7 flex justify-between items-center gap-4 font-bold text-lg text-slate-900 cursor-pointer list-none hover:text-amber-700 transition-colors">
            <span class="leading-snug">{faq.question}</span>
            <svg class="w-5 h-5 shrink-0 text-amber-700 transition-transform duration-200 group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6 9l6 6 6-6"/>
            </svg>
          </summary>
          <div class="px-7 pb-7 text-slate-600 text-base leading-loose border-t border-slate-100 pt-6">
            {faq.answer}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
