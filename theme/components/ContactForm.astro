---
import { getTranslations } from '~theme/i18n';
import { defaultLocale } from '~theme/i18n/utils';
import siteConfig from '@/config/site.json';

const { locale = defaultLocale } = Astro.props;
const t = getTranslations(locale);
const c = t.contact;
---

<div class="card bg-white p-8 max-w-2xl mx-auto">
  <form id="contact-form" class="flex flex-col gap-6" data-sending-label={c.sending} data-submit-label={c.submit} data-success-label={c.success} data-error-label={c.error}>
    <input type="hidden" name="access_key" value="YOUR_WEB3FORMS_ACCESS_KEY" />
    <input type="hidden" name="subject" value="New Contact Form Submission - Gold Price Germany" />

    <div class="flex flex-col gap-2">
      <label for="name" class="text-sm font-semibold text-slate-700">{c.nameLabel}</label>
      <input
        type="text"
        id="name"
        name="name"
        required
        placeholder={c.namePlaceholder}
        class="bg-slate-50 border border-slate-200 text-slate-900 p-3.5 rounded-xl font-medium focus:outline-none focus:border-amber-500 transition-colors"
      />
    </div>

    <div class="flex flex-col gap-2">
      <label for="email" class="text-sm font-semibold text-slate-700">{c.emailLabel}</label>
      <input
        type="email"
        id="email"
        name="email"
        required
        placeholder={c.emailPlaceholder}
        class="bg-slate-50 border border-slate-200 text-slate-900 p-3.5 rounded-xl font-medium focus:outline-none focus:border-amber-500 transition-colors"
      />
    </div>

    <div class="flex flex-col gap-2">
      <label for="message" class="text-sm font-semibold text-slate-700">{c.messageLabel}</label>
      <textarea
        id="message"
        name="message"
        rows="5"
        required
        placeholder={c.messagePlaceholder}
        class="bg-slate-50 border border-slate-200 text-slate-900 p-3.5 rounded-xl font-medium focus:outline-none focus:border-amber-500 transition-colors resize-y"
      ></textarea>
    </div>

    <button
      type="submit"
      id="submit-btn"
      class="btn-primary w-full justify-center py-4 text-base font-bold"
    >
      {c.submit}
    </button>

    <div id="form-status" class="text-center font-bold text-sm hidden p-3 rounded-xl" role="status" aria-live="polite"></div>

    <div class="text-center text-xs text-slate-500 border-t border-slate-100 pt-4">
      {c.directEmail}
      <a href={`mailto:${siteConfig.contactEmail}`} class="text-amber-700 underline font-bold ms-1">{siteConfig.contactEmail}</a>
    </div>
  </form>
</div>

<script>
  function setupForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const btn = document.getElementById('submit-btn') as HTMLButtonElement;
    const status = document.getElementById('form-status');
    if (!form) return;

    const { sendingLabel, submitLabel, successLabel, errorLabel } = form.dataset;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!btn || !status) return;

      btn.disabled = true;
      btn.textContent = sendingLabel || 'Sending...';
      status.className = 'text-center font-bold text-sm block p-3 rounded-xl bg-blue-50 text-blue-700 border border-blue-200';
      status.textContent = sendingLabel || 'Sending...';

      const formData = new FormData(form);

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: formData
        });
        const data = await response.json();

        if (response.status === 200) {
          status.className = 'text-center font-bold text-sm block p-3 rounded-xl bg-emerald-50 text-emerald-700 border border-emerald-200';
          status.textContent = successLabel || 'Message sent successfully!';
          form.reset();
        } else {
          throw new Error(data.message || 'Submission failed');
        }
      } catch (err) {
        status.className = 'text-center font-bold text-sm block p-3 rounded-xl bg-red-50 text-red-700 border border-red-200';
        status.textContent = errorLabel || 'Something went wrong.';
      } finally {
        btn.disabled = false;
        btn.textContent = submitLabel || 'Send Message';
      }
    });
  }

  setupForm();
  document.addEventListener('astro:page-load', setupForm);
</script>
