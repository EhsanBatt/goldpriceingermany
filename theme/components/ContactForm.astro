---
import { getTranslations } from '~theme/i18n';
import { defaultLocale } from '~theme/i18n/utils';
import siteConfig from '@/config/site.json';

const { locale = defaultLocale } = Astro.props;
const t = getTranslations(locale);
const isAr = locale === 'ar';
---

<div class="bg-[#161e31]/80 border border-[rgba(212,175,55,0.22)] p-8 rounded-3xl shadow-2xl max-w-2xl mx-auto">
  <form id="contact-form" class="flex flex-col gap-6">
    <input type="hidden" name="access_key" value="YOUR_WEB3FORMS_ACCESS_KEY" />
    <input type="hidden" name="subject" value="New Contact Form Submission - Gold Price Germany" />
    
    <div class="flex flex-col gap-2">
      <label for="name" class="text-sm font-semibold text-slate-300">{isAr ? 'الاسم الكامل:' : 'Full Name:'}</label>
      <input
        type="text"
        id="name"
        name="name"
        required
        placeholder={isAr ? 'أدخل اسمك هنا' : 'Enter your name'}
        class="bg-[#070a12] border border-white/10 text-white p-3.5 rounded-xl font-medium focus:outline-none focus:border-[#d4af37] transition-colors"
      />
    </div>

    <div class="flex flex-col gap-2">
      <label for="email" class="text-sm font-semibold text-slate-300">{isAr ? 'البريد الإلكتروني:' : 'Email Address:'}</label>
      <input
        type="email"
        id="email"
        name="email"
        required
        placeholder={isAr ? 'example@email.com' : 'example@email.com'}
        class="bg-[#070a12] border border-white/10 text-white p-3.5 rounded-xl font-medium focus:outline-none focus:border-[#d4af37] transition-colors"
      />
    </div>

    <div class="flex flex-col gap-2">
      <label for="message" class="text-sm font-semibold text-slate-300">{isAr ? 'الرسالة أو الاستفسار:' : 'Message:'}</label>
      <textarea
        id="message"
        name="message"
        rows="5"
        required
        placeholder={isAr ? 'اكتب رسالتك أو استفسارك هنا...' : 'Write your inquiry here...'}
        class="bg-[#070a12] border border-white/10 text-white p-3.5 rounded-xl font-medium focus:outline-none focus:border-[#d4af37] transition-colors resize-y"
      ></textarea>
    </div>

    <button
      type="submit"
      id="submit-btn"
      class="btn-primary w-full justify-center py-4 text-base font-bold"
    >
      ✉️ {isAr ? 'إرسال الرسالة الآن' : 'Send Message Now'}
    </button>

    <div id="form-status" class="text-center font-bold text-sm hidden p-3 rounded-xl"></div>

    <div class="text-center text-xs text-slate-400 border-t border-white/5 pt-4">
      {isAr ? 'أو يمكنك مراسلتنا مباشرة عبر البريد الإلكتروني:' : 'Or reach us directly via email:'}
      <a href={`mailto:${siteConfig.contactEmail}`} class="text-[#fbe8a6] underline font-bold ml-1">{siteConfig.contactEmail}</a>
    </div>
  </form>
</div>

<script>
  function setupForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const btn = document.getElementById('submit-btn') as HTMLButtonElement;
    const status = document.getElementById('form-status');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!btn || !status) return;

      btn.disabled = true;
      btn.innerHTML = '⏳ جارٍ الإرسال... / Sending...';
      status.className = 'text-center font-bold text-sm block p-3 rounded-xl bg-blue-900/40 text-blue-300 border border-blue-500/30';
      status.textContent = 'جارٍ إرسال رسالتك... / Sending your message...';

      const formData = new FormData(form);

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: formData
        });
        const data = await response.json();

        if (response.status === 200) {
          status.className = 'text-center font-bold text-sm block p-3 rounded-xl bg-emerald-900/40 text-emerald-300 border border-emerald-500/30';
          status.textContent = '✅ تم إرسال رسالتك بنجاح! سنتواصل معك قريباً. / Message sent successfully!';
          form.reset();
        } else {
          throw new Error(data.message || 'Submission failed');
        }
      } catch (err) {
        status.className = 'text-center font-bold text-sm block p-3 rounded-xl bg-red-900/40 text-red-300 border border-red-500/30';
        status.textContent = '❌ حدث خطأ أثناء الإرسال. يرجى المراسلة عبر البريد المباشر.';
      } finally {
        btn.disabled = false;
        btn.innerHTML = '✉️ إرسال الرسالة الآن / Send Message Now';
      }
    });
  }

  setupForm();
  document.addEventListener('astro:page-load', setupForm);
</script>
